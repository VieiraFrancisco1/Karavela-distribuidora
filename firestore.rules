rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.token.email == '0vieira.francisco0@gmail.com';
    }

    match /users/{userId} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == userId);

      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'phone',
          'loginType',
          'createdAt',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.customerName is string
        && request.resource.data.customerPhone is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.keys().hasOnly([
          'userId',
          'customerName',
          'customerPhone',
          'fulfillment',
          'neighborhood',
          'address',
          'complement',
          'reference',
          'payment',
          'changeFor',
          'subtotal',
          'deliveryFee',
          'total',
          'items',
          'status',
          'createdAt',
          'updatedAt'
        ]);

      allow get: if isOwner()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow list: if isOwner()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow update, delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
