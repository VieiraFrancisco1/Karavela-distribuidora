{
  "name": "karavela-distribuidora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "node --import tsx --test tests/models.test.mjs tests/publish.test.mjs",
    "test:firebase": "firebase emulators:exec --project demo-karavela --only auth,firestore \"node --import tsx --test tests/firebase.test.mjs\"",
    "firebase:publish": "node --import tsx scripts/publish-firebase.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "firebase": "^12.19.0",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.1",
    "tsx": "^4.23.15"
  }
}
